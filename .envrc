# direnv hook for the learning-ai course repo.
# Points `python` at the project venv (uv-managed CPython 3.12), never the
# system interpreter. Requires: `direnv allow` on first cd, and
# ./scripts/setup-env.sh run at least once.
export UV_PYTHON_INSTALL_DIR="$(pwd)/.local/python"
export VIRTUAL_ENV="$(pwd)/.venv"
export PATH="$(pwd)/.venv/bin:$PATH"

if [ ! -d .venv ]; then
  log_status "No .venv yet - run ./scripts/setup-env.sh"
fi
